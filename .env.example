# Optional explicit FastEmbed cache root. Current FastEmbed spelling.
FASTEMBED_CACHE_DIR=

# Optional legacy-compatible single cache root.
FASTEMBED_CACHE_PATH=

# Optional colon-separated cache roots used only by the maintainer sync audit.
FASTEMBED_CACHE_PATHS=

# Optional alternate manifest path for validation/testing.
MODELS_MANIFEST=

# Optional non-negative delay in seconds between Hugging Face API requests.
HF_API_DELAY_SECONDS=0.2

# Required only when installing a verified ONNX Runtime archive. Must be an explicit absolute,
# non-root directory. Example: /home/user/.cache/ort.pyke.io
ORT_CACHE_DIR=

# GitHub CLI authentication is intentionally not declared here. Authenticate with `gh auth login`
# or your existing secure GitHub CLI credential store; never put a token in this file.
